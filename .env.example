# ─────────────────────────────────────────────────────────────────────────────
# Vintoria — site commercial
#
# SANS CES VARIABLES, le formulaire de /demonstration ÉCHOUE FRANCHEMENT :
# il affiche « Le service d'envoi est momentanément indisponible » et conserve
# la saisie. Il n'affiche JAMAIS de remerciement sur un message non parti.
# C'est volontaire : un faux succès laisserait un prospect attendre un rappel
# qui n'arriverait pas.
# ─────────────────────────────────────────────────────────────────────────────

# Clé Resend — le MÊME compte que vintoria-pro. Ne pas en créer un second.
RESEND_API_KEY=

# Expéditeur affiché. Le domaine doit être vérifié dans Resend.
RESEND_FROM_EMAIL="Vintoria <contact@vintoria.com>"

# Destinataire des demandes de démonstration.
CONTACT_EMAIL=contact@vintoria.com
